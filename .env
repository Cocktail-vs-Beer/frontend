# Ticketnode backend. Server-side only: the browser talks to /api/* on this
# site, which proxies to these.
#
# TICKETNODE_API_URL is unset on purpose: it defaults to http://localhost:3000
# in development and https://ticketnode.online everywhere else. Set it to point
# a local dev server at production, or a preview deploy at staging.
TICKETNODE_API_URL=https://ticketnode.online

TICKETNODE_EVENT_ID=f1aa532c-afc1-41c4-ae11-2fd6f083f3d0
